<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>NumericCrossCheck</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ModSrc>$(MSBuildThisFileDirectory)../../src/VSTerrainDiffusion</ModSrc>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <!--
    The numeric core is compiled straight from the mod's sources rather than referenced as a
    library, so this runs without the Vintage Story assemblies. Shims.cs stands in for the two
    pieces that would otherwise pull the game in.
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Shims.cs" />
    <Compile Include="$(ModSrc)/Pipeline/FastNoiseLite.cs" />
    <Compile Include="$(ModSrc)/Pipeline/PortableRng.cs" />
    <Compile Include="$(ModSrc)/Pipeline/GaussianNoisePatch.cs" />
    <Compile Include="$(ModSrc)/Pipeline/EdmScheduler.cs" />
    <Compile Include="$(ModSrc)/Pipeline/LaplacianUtils.cs" />
    <Compile Include="$(ModSrc)/Pipeline/SyntheticMapFactory.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
