<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VSTerrainDiffusion.Tools</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>PipelineTest</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <VintagestoryDir Condition="'$(VintagestoryDir)' == '' AND '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintagestoryDir>
    <VintagestoryDir Condition="'$(VintagestoryDir)' == '' AND Exists('/opt/vintagestory/VintagestoryAPI.dll')">/opt/vintagestory</VintagestoryDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintagestoryDir)/VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintagestoryDir)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/VSTerrainDiffusion/VSTerrainDiffusion.csproj" />
  </ItemGroup>

</Project>
