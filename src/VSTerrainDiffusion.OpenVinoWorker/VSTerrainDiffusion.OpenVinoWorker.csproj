<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VSTerrainDiffusion.OpenVinoWorker</AssemblyName>
    <RootNamespace>VSTerrainDiffusion</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <UseAppHost>false</UseAppHost>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\VSTerrainDiffusion\Native\OpenVinoRuntime.cs" Link="Native\OpenVinoRuntime.cs" />
    <Compile Include="..\VSTerrainDiffusion\Native\OpenVinoWorkerProtocol.cs" Link="Native\OpenVinoWorkerProtocol.cs" />
  </ItemGroup>
</Project>
