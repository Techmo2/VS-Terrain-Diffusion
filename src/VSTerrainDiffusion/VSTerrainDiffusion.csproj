<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VSTerrainDiffusion</AssemblyName>
    <RootNamespace>VSTerrainDiffusion</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>0.1.0</Version>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <!-- Path to the Vintage Story installation. Override with -p:VintagestoryDir=/path -->
  <PropertyGroup>
    <VintagestoryDir Condition="'$(VintagestoryDir)' == '' AND '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintagestoryDir>
    <VintagestoryDir Condition="'$(VintagestoryDir)' == '' AND Exists('/opt/vintagestory/VintagestoryAPI.dll')">/opt/vintagestory</VintagestoryDir>
    <VintagestoryDir Condition="'$(VintagestoryDir)' == '' AND Exists('$(HOME)/Vintagestory/VintagestoryAPI.dll')">$(HOME)/Vintagestory</VintagestoryDir>
  </PropertyGroup>

  <Target Name="CheckVintagestoryDir" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(VintagestoryDir)/VintagestoryAPI.dll')"
           Text="Could not locate the Vintage Story installation. Set the VINTAGE_STORY environment variable or pass -p:VintagestoryDir=/path/to/vintagestory." />
  </Target>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintagestoryDir)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintagestoryDir)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VintagestoryDir)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VintagestoryDir)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintagestoryDir)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintagestoryDir)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The vector type Rivers' network is built from; see RiversCompat.BeforeGenerateRiver. -->
    <Reference Include="OpenTK.Mathematics">
      <HintPath>$(VintagestoryDir)/Lib/OpenTK.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Only used to hand the model's heights to another mod's terrain generator; see WatershedsCompat. -->
    <Reference Include="0Harmony">
      <HintPath>$(VintagestoryDir)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    ONNX Runtime runs in the worker process, never in the game, so the mod references none of it.
    The worker and its managed ONNX Runtime binding are embedded and written out on first use
    (WorkerProcess); the native runtime is downloaded by OnnxRuntimeBootstrap.
  -->
  <ItemGroup>
    <ProjectReference Include="..\VSTerrainDiffusion.Worker\VSTerrainDiffusion.Worker.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\VSTerrainDiffusion.Worker\bin\$(Configuration)\net10.0\VSTerrainDiffusion.Worker.dll"
                      LogicalName="VSTerrainDiffusion.Worker.dll" />
    <EmbeddedResource Include="..\VSTerrainDiffusion.Worker\bin\$(Configuration)\net10.0\VSTerrainDiffusion.Worker.deps.json"
                      LogicalName="VSTerrainDiffusion.Worker.deps.json" />
    <EmbeddedResource Include="..\VSTerrainDiffusion.Worker\bin\$(Configuration)\net10.0\VSTerrainDiffusion.Worker.runtimeconfig.json"
                      LogicalName="VSTerrainDiffusion.Worker.runtimeconfig.json" />
    <EmbeddedResource Include="..\VSTerrainDiffusion.Worker\bin\$(Configuration)\net10.0\Microsoft.ML.OnnxRuntime.dll"
                      LogicalName="Microsoft.ML.OnnxRuntime.dll" />
    <EmbeddedResource Include="..\VSTerrainDiffusion.Worker\bin\$(Configuration)\net10.0\System.Numerics.Tensors.dll"
                      LogicalName="System.Numerics.Tensors.dll" />
  </ItemGroup>

  <!-- The debug map page is served straight out of the assembly, so it cannot go missing. -->
  <ItemGroup>
    <EmbeddedResource Include="Debug/map.html" LogicalName="VSTerrainDiffusion.Debug.map.html" />
  </ItemGroup>

  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="modicon.png" Condition="Exists('modicon.png')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
