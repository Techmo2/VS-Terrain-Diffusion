{
  "worldconfig-category-terraindiffusion": "Terrain Diffusion",
  "worldattribute-terraindiffusionEnabled": "Terrain Diffusion",
  "worldattribute-terraindiffusionEnabled-desc": "Generate terrain and climate with the Terrain Diffusion neural model instead of the vanilla landform generator.",
  "worldattribute-terraindiffusionScale": "Resolution",
  "worldattribute-terraindiffusionScale-desc": "How many real-world metres one block represents, horizontally and vertically alike.",
  "worldconfig-terraindiffusionScale-30": "30 m per block (most terrain per step)",
  "worldconfig-terraindiffusionScale-15": "15 m per block (recommended)",
  "worldconfig-terraindiffusionScale-10": "10 m per block",
  "worldconfig-terraindiffusionScale-7.5": "7.5 m per block",
  "worldconfig-terraindiffusionScale-6": "6 m per block",
  "worldconfig-terraindiffusionScale-5": "5 m per block (most immersive)",
  "worldattribute-terraindiffusionVerticalExaggeration": "Vertical exaggeration",
  "worldattribute-terraindiffusionVerticalExaggeration-desc": "Multiplies terrain height above sea level. At 1x a block is exactly as tall as it is wide.",
  "worldconfig-terraindiffusionVerticalExaggeration-0.5": "0.5x (gentler)",
  "worldconfig-terraindiffusionVerticalExaggeration-0.75": "0.75x",
  "worldconfig-terraindiffusionVerticalExaggeration-1": "1x (true scale)",
  "worldconfig-terraindiffusionVerticalExaggeration-1.25": "1.25x",
  "worldconfig-terraindiffusionVerticalExaggeration-1.5": "1.5x",
  "worldconfig-terraindiffusionVerticalExaggeration-2": "2x (extreme)",
  "worldattribute-terraindiffusionSeaLevel": "Sea level",
  "worldattribute-terraindiffusionSeaLevel-desc": "Where the sea sits. Vanilla puts it 43% of the way up, so a taller world spends much of its extra height underground. At Y 128 the rock and ocean below the sea stay 128 blocks deep (a vanilla 256-block world has 110) and every other block goes to the land above it. Climate, soil, trees and weather keep their height above the sea either way.",
  "worldconfig-terraindiffusionSeaLevel-vanilla": "Vanilla (43% of world height)",
  "worldconfig-terraindiffusionSeaLevel-128": "Y 128 (more room above the sea)",
  "worldattribute-terraindiffusionClimate": "Climate",
  "worldattribute-terraindiffusionClimate-desc": "Whether the model drives the climate as well as the terrain. The model predicts real bioclimatic variables which set the world's temperature, rainfall, forests and seasons.",
  "worldconfig-terraindiffusionClimate-full": "Model climate (recommended)",
  "worldconfig-terraindiffusionClimate-off": "Off - vanilla climate",
  "worldattribute-terraindiffusionClimateModel": "Climate model",
  "worldattribute-terraindiffusionClimateModel-desc": "Seasonal also predicts the shape of each place's year, when its rain falls and its day-night temperature swing, which give Köppen climate classes. Annual is the original model. They draw different landscapes from the same seed.",
  "worldconfig-terraindiffusionClimateModel-seasonal": "Seasonal (recommended)",
  "worldconfig-terraindiffusionClimateModel-annual": "Annual (original)",
  "worldattribute-terraindiffusionCoarsePooling": "Terrain intensity",
  "worldattribute-terraindiffusionCoarsePooling-desc": "Packs more landscape into the same distance: the model's large-scale map is drawn as usual and every 2x2 or 4x4 block of it squeezed into one cell, so continents, ranges and valleys come closer together and the relief between them steepens. It stays realistic because the model is never asked for anything it was not trained on; 4x is dramatic.",
  "worldconfig-terraindiffusionCoarsePooling-off": "Off (real-world spacing)",
  "worldconfig-terraindiffusionCoarsePooling-2x": "2x",
  "worldconfig-terraindiffusionCoarsePooling-4x": "4x (dramatic)",
  "worldattribute-terraindiffusionCoarsePoolMode": "Intensity mode",
  "worldattribute-terraindiffusionCoarsePoolMode-desc": "How each squeezed block becomes one cell. Average keeps it realistic. Extreme keeps the highest ground and the deepest valley floor of each block, for taller peaks and deeper cuts, at some cost to realism. Does nothing with terrain intensity off.",
  "worldconfig-terraindiffusionCoarsePoolMode-average": "Average (realistic)",
  "worldconfig-terraindiffusionCoarsePoolMode-extreme": "Extreme (peaks and valleys)",
  "worldattribute-terraindiffusionDetailRedraw": "Detail redraw",
  "worldattribute-terraindiffusionDetailRedraw-desc": "How much of the detail model's first draw is thrown away and redrawn. 0.35 is the model author's quality optimum; higher varies coast shapes and small valleys more.",
