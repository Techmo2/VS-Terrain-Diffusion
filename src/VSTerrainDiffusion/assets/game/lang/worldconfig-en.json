  "worldattribute-terraindiffusionOffloadModels": "Offload models between stages",
  "worldattribute-terraindiffusionOffloadModels-desc": "Keep only one of the three models on the GPU at a time. Holds peak VRAM near 1.5 GB instead of about 2.5 GB, and roughly triples the time per terrain tile. Turn on only if the models will not fit on the card. Takes effect the next time the world is loaded.",
  "worldattribute-terraindiffusionModelLoadMode": "Model loading",
  "worldattribute-terraindiffusionModelLoadMode-desc": "Open model graphs directly from their files, or read them into memory first, which costs roughly 1 GB of temporary RAM. Only use from memory if you are also forced to offload models.",
  "worldconfig-terraindiffusionModelLoadMode-file": "From disk (recommended)",
  "worldconfig-terraindiffusionModelLoadMode-memory": "From memory",
  "worldattribute-terraindiffusionValidateModelHashes": "Verify model files",
  "worldattribute-terraindiffusionValidateModelHashes-desc": "Check the SHA-256 of model files already on disk at every start. Turning this off saves a few seconds per start; file sizes are still checked. Takes effect the next time the world is loaded.",
  "worldattribute-terraindiffusionDownloadRuntime": "Download inference runtimes",
  "worldattribute-terraindiffusionDownloadRuntime-desc": "Fetch the matching ONNX Runtime and, when selected, OpenVINO native libraries automatically. Turn off to supply them yourself in TerrainDiffusionModels/onnxruntime/. Takes effect the next time the world is loaded.",
  "worldattribute-terraindiffusionTileDatabase": "Keep terrain tiles on disk",
  "worldattribute-terraindiffusionTileDatabase-desc": "Saves generated terrain to disk so it's never generated twice. Pregenerate with /tdiff pregen. Cleared automatically when the world's terrain settings change. Applies on the next world load."
}
