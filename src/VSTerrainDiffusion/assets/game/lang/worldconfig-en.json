  "worldattribute-terraindiffusionWaterThreads": "Water threads",
  "worldattribute-terraindiffusionWaterThreads-desc": "CPU threads used to work out lakes and rivers. Auto uses about one per physical core, at most 8. Never changes the world.",
  "worldconfig-terraindiffusionWaterThreads-auto": "auto",
  "worldconfig-terraindiffusionWaterThreads-1": "1",
